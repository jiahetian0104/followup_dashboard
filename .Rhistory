"lastName",
"sex",
"birthday",
"race",
"statusId",
"Events (All or None)"
)
# Build Body
body_list <- list(
"teamId" = "pze6EXgGw6hLwhhRy",
"export-type" = "QhZZT24wtWCpGkKdE",
